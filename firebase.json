{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "firestore.rules",
      "README.md",
      "**/.*",
      "**/node_modules/**",
      "scripts/**",
      "reportes/**",
      "entregables/**"
    ],
    "headers": [
      {
        "source": "**/@(sw|sw-push|sw-sync).js",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "/manifest.json",
        "headers": [{ "key": "Content-Type", "value": "application/manifest+json" }]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}
